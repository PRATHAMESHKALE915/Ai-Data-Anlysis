# AI Data Analyst Environment Variables Example Template
# Copy this file to .env.local and fill in your actual credentials.

# Google Gemini API Key (Required for AI data analysis & cleaning)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web Config (Publicly safe client-side config)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional Cloud SQL / PostgreSQL (Production Server Database)
# SQL_HOST=127.0.0.1
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=your_secure_db_password
# SQL_DATABASE=ai_data_analyst
