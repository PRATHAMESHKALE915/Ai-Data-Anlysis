    "@types/express": "^4.17.21",
    "@types/html2canvas": "^0.5.35",
    "@types/jszip": "^3.4.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pako": "^2.0.4",
    "@types/pg": "^8.20.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
