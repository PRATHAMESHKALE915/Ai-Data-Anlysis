rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);
      
      // User subcollections
      match /datasets/{datasetId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(datasetId);
      }
      
      match /reports/{reportId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(reportId);
      }
      
      match /routines/{routineId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(routineId);
      }
    }
  }
}
